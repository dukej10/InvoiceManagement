    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// ===== SCRIPT PARA LA PESTAÑA \"Tests\" DE POSTMAN =====\r",
          "// Solo ejecutar este script si la URL contiene /client/create\r",
          "\r",
          "const requestUrl = pm.request.url.toString();\r",
          "\r",
          "if (requestUrl.includes(\"/clients/create\")) {\r",
          "\r",
          "    // 1. Validar que el status sea 201\r",
          "    pm.test(\"Status code es 201 (cliente creado)\", function () {\r",
          "        pm.expect(pm.response.code).to.eql(201);\r",
          "    });\r",
          "\r",
          "    // 2. Solo continuar si el código es 201\r",
          "    if (pm.response.code === 200) {\r",
          "\r",
          "        // Parsear el JSON de la respuesta\r",
          "        const responseJson = pm.response.json();\r",
          "\r",
          "        // 3. Validar que exista el campo data.id\r",
          "        pm.test(\"La respuesta contiene data.id\", function () {\r",
          "            pm.expect(responseJson).to.have.property(\"data\");\r",
          "            pm.expect(responseJson.data).to.have.property(\"id\");\r",
          "            pm.expect(responseJson.data.id)\r",
          "                .to.be.a(\"number\")\r",
          "                .or.a(\"string\")\r",
          "                .and.not.empty;\r",
          "        });\r",
          "\r",
          "        // 4. Guardar el ID del cliente creado en una variable de colección\r",
          "        const clientId = responseJson.data.id;\r",
          "        pm.collectionVariables.set(\"client-id\", clientId);\r",
          "\r",
          "        // 5. Mensajes de debug en consola\r",
          "        console.log(\"Cliente creado con éxito (201)\");\r",
          "        console.log(\"   URL:\", requestUrl);\r",
          "        console.log(\"   client-id guardado:\", clientId);\r",
          "\r",
          "        // 6. Confirmar que la variable quedó guardada correctamente\r",
          "        pm.test(\"Variable de colección 'client-id' fue actualizada correctamente\", function () {\r",
          "            pm.expect(pm.collectionVariables.get(\"client-id\")).to.eql(clientId);\r",
          "        });\r",
          "\r",
          "    } else {\r",
          "        console.log(\"ℹ️ La petición no devolvió 201, no se guarda client-id\");\r",
          "    }\r",
          "} else if (requestUrl.includes(\"/invoices/create\")) {\r",
          "    // 1. Verificar que la respuesta sea exitosa (código 200 o 201, ambos son válidos para creación)\r",
          "    pm.test(\"Status code is 200 o 201 (creación exitosa)\", function () {\r",
          "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
          "    });\r",
          "\r",
          "    // 2. Parsear el JSON de la respuesta\r",
          "    let responseJson;\r",
          "    responseJson = pm.response.json();\r",
          "\r",
          "    if (pm.response.code === 200) {\r",
          "        \r",
          "        // 3. Validar que exista el campo data.id\r",
          "        pm.test(\"La respuesta contiene data.id\", function () {\r",
          "            pm.expect(responseJson).to.have.property(\"data\");\r",
          "            pm.expect(responseJson.data).to.have.property(\"id\");\r",
          "            pm.expect(responseJson.data.id).to.be.a(\"number\").or.a(\"string\").and.not.empty;\r",
          "        });\r",
          "\r",
          "        // 4. Guardar el ID del cliente creado en una variable de colección\r",
          "        const invoiceId = responseJson.data.id;\r",
          "        pm.collectionVariables.set(\"invoice-id\", invoiceId);\r",
          "\r",
          "        // 5. Mensajes de debug en consola\r",
          "        console.log(\"Factura creado con éxito\", responseJson);\r",
          "        console.log(\"   URL:\", requestUrl);\r",
          "        console.log(\"   invoice-id guardado:\", invoiceId);\r",
          "\r",
          "        // 6. Test final para confirmar que la variable quedó guardada correctamente\r",
          "        pm.test(\"Variable de colección 'invoice-id' fue actualizada correctamente\", function () {\r",
          "            pm.expect(pm.collectionVariables.get(\"invoice-id\")).to.eql(invoiceId);\r",
          "        });\r",
          "    }\r",
          "}  else if(requestUrl.includes(\"/auth/login\")) {\r",
          "     pm.test(\"Status code is 200 o 201 (creación exitosa)\", function () {\r",
          "        pm.expect(pm.response.code).to.be.oneOf([200]);\r",
          "    });\r",
          "     // 2. Parsear el JSON de la respuesta\r",
          "    let responseJson;\r",
          "    responseJson = pm.response.json();\r",
          "\r",
          "    if (pm.response.code === 200) {\r",
          "         pm.test(\"La respuesta contiene data.accessToken\", function () {\r",
          "            pm.expect(responseJson).to.have.property(\"data\");\r",
          "            pm.expect(responseJson.data).to.have.property(\"accessToken\");\r",
          "            pm.expect(responseJson.data.accessToken).to.be.a(\"string\").and.not.empty;\r",
          "        });\r",
          "\r",
          "\r",
          "        const accessToken = responseJson.data.accessToken;\r",
          "        pm.collectionVariables.set(\"access-token\", accessToken);\r",
          "\r",
          "        // 5. Mensajes de debug en consola\r",
          "        console.log(\"Factura creado con éxito\", responseJson);\r",
          "        console.log(\"   URL:\", requestUrl);\r",
          "        console.log(\"   access-token:\", accessToken);\r",
          "\r",
          "        pm.test(\"Variable de colección 'access-token' fue actualizada correctamente\", function () {\r",
          "            pm.expect(pm.collectionVariables.get(\"access-token\")).to.eql(accessToken);\r",
          "        });\r",
          "    }\r",
          "}"
        ]
      }
    }
